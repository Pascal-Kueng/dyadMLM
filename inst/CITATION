## Keep the citation synchronized with DESCRIPTION while using the stable
## Zenodo concept DOI across package releases.
local({
  package_citation <- citation(auto = meta)
  package_citation$doi <- "10.5281/zenodo.21481720"
  package_citation$url <- NULL
  package_citation$title <- "dyadMLM: Tools for dyadic multilevel models"
  package_citation$textVersion <- sprintf(
    "Küng, P. (%s). %s (Version %s) [Computer software]. https://doi.org/%s",
    package_citation$year, package_citation$title, meta$Version, package_citation$doi
  )
  package_citation
})
