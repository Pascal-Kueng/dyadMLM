  ild_data$series <- interaction(
    ild_data$coupleID,
    ild_data$personID,
    drop = TRUE
  )
  ild_model <- glmmTMB::glmmTMB(
    closeness ~
      gender +
      (1 | coupleID) +
      ar1(0 + time_f | series),
    data = ild_data
